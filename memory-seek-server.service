# ── Memory Seek 后端服务 systemd 单元示例 ──
#
# 前置依赖(裸机/systemd 部署):
#   - 视频转码需要宿主机已安装 ffmpeg(apt install ffmpeg), 与 config 的
#     visual.transcode.ffmpeg_path(默认 "ffmpeg", 取自 PATH)对应;
#   - 容器部署则无需在宿主机安装, 运行镜像已内置(见 build/Dockerfile.runtime)。

[Unit]
Description=Memory Seek Backend Server
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=memory-seek
Group=memory-seek
WorkingDirectory=/opt/memory-seek

# 日志级别与运行配置（可通过 EnvironmentFile 覆盖）
Environment=RUST_LOG=info
EnvironmentFile=/etc/memory-seek/memory-seek-server.env

ExecStart=/usr/local/bin/memory-seek-server -c /etc/memory-seek/config.yaml

# ── CPU 限制：最多用 90%，留 10% 给系统和 SSH ──
CPUQuota=90%

# 软限制：达到后节流，不杀进程
MemoryHigh=80%
# 硬限制：绝对上限，超出则 OOM Killer 终止进程
MemoryMax=90%

# 崩溃自动重启
Restart=on-failure
RestartSec=5

# 优雅关闭：主程序响应 SIGTERM 后执行收尾，超时后由 systemd 强制结束
KillSignal=SIGTERM
TimeoutStopSec=30

# 日志交给 journald 管理（显式声明，与默认一致）
StandardOutput=journal
StandardError=journal

# 资源与安全加固
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/backups/memory-seek

[Install]
WantedBy=multi-user.target
